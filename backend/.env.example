# Database Configuration
# PostgreSQL connection string (Neon, Render, or any PostgreSQL provider)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# JWT Secret Key
# IMPORTANT: Generate a strong random secret for production
# You can use: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Frontend URL
# In production, this should be your deployed frontend URL (e.g., https://your-app.netlify.app)
FRONTEND_URL="http://localhost:5173"

# Port (Optional - Render will provide this automatically)
# PORT=3000
